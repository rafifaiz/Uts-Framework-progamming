            "url": { "raw": "{{baseUrl}}/stock-movements", "host": ["{{baseUrl}}"], "path": ["stock-movements"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"OUT\",\n  \"referenceNumber\": \"OUT-ERR-001\",\n  \"movementDate\": \"2024-01-25\",\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1000,\n      \"unitPrice\": 15000000\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Get Non-existent Category (404)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/categories/00000000-0000-0000-0000-000000000000", "host": ["{{baseUrl}}"], "path": ["categories", "00000000-0000-0000-0000-000000000000"] }
          }
        },
        {
          "name": "Validation Error - Missing Required Fields (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] },
            "body": {
