    {
      "name": "Stock Movements",
      "item": [
        {
          "name": "Stock IN - Barang Masuk",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/stock-movements", "host": ["{{baseUrl}}"], "path": ["stock-movements"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"IN\",\n  \"referenceNumber\": \"IN-2024-001\",\n  \"movementDate\": \"2024-01-15\",\n  \"notes\": \"Pembelian stok awal laptop gaming\",\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 10,\n      \"unitPrice\": 12000000\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response has id', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.collectionVariables.set('stockMovementId', json.id);",
                  "});",
                  "pm.test('Product stock updated', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.items[0].product.currentStock).to.eql(10);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Stock Movements",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/stock-movements", "host": ["{{baseUrl}}"], "path": ["stock-movements"] }
          }
        },
        {
          "name": "Get Stock Report",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/stock-movements/report/stock", "host": ["{{baseUrl}}"], "path": ["stock-movements", "report", "stock"] }
          }
        },
        {
          "name": "Get Stock Movement by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/stock-movements/{{stockMovementId}}", "host": ["{{baseUrl}}"], "path": ["stock-movements", "{{stockMovementId}}"] }
          }
        },
        {
          "name": "Stock OUT - Barang Keluar",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/stock-movements", "host": ["{{baseUrl}}"], "path": ["stock-movements"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"OUT\",\n  \"referenceNumber\": \"OUT-2024-001\",\n  \"movementDate\": \"2024-01-20\",\n  \"notes\": \"Penjualan ke customer\",\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2,\n      \"unitPrice\": 15000000\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Stock reduced', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.items[0].product.currentStock).to.eql(8);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Stock Movement",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/stock-movements/{{stockMovementId}}", "host": ["{{baseUrl}}"], "path": ["stock-movements", "{{stockMovementId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Diupdate: Pembelian stok awal laptop gaming - revisi\"\n}"
            }
          }
        },
        {
          "name": "Delete Stock Movement (Rollback Stock)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/stock-movements/{{stockMovementId}}", "host": ["{{baseUrl}}"], "path": ["stock-movements", "{{stockMovementId}}"] }
